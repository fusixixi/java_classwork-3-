<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- 请假管理 FXML 配置文件 -->
<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" prefWidth="1000.0" fx:controller="com.teach.javafx.controller.StudentLeaveController">
    <top>
        <HBox id="HBox" alignment="CENTER_LEFT" spacing="5.0">
            <children>
                <FlowPane prefHeight="40.0" prefWidth="300.0" BorderPane.alignment="CENTER">
                    <children>
                        <Button fx:id="addButton" mnemonicParsing="false" onAction="#onAddButtonClick" text="新建申请">
                            <FlowPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </FlowPane.margin>
                        </Button>
                    </children>
                </FlowPane>
                <Pane prefHeight="-1.0" prefWidth="-1.0" HBox.hgrow="ALWAYS" />
                <FlowPane alignment="TOP_RIGHT" prefHeight="40.0" prefWidth="500.0" BorderPane.alignment="CENTER">
                    <children>
                        <Label fx:id="searchLabel" prefWidth="65.0" text="学号/姓名">
                            <FlowPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </FlowPane.margin>
                        </Label>
                        <TextField fx:id="searchTextField" prefWidth="120.0">
                            <FlowPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </FlowPane.margin>
                        </TextField>
                        <Label fx:id="stateLabel" prefWidth="65.0" text="审批状态">
                            <FlowPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </FlowPane.margin>
                        </Label>
                        <ComboBox fx:id="stateComboBox" prefWidth="120.0">
                            <FlowPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </FlowPane.margin>
                        </ComboBox>
                        <Button mnemonicParsing="false" onAction="#onQueryButtonClick" text="查询">
                            <FlowPane.margin>
                                <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                            </FlowPane.margin>
                        </Button>
                    </children>
                </FlowPane>
            </children>
            <padding>
                <Insets bottom="3.0" left="3.0" right="3.0" top="3.0" />
            </padding>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.7,0.3">
            <items>
                <TableView fx:id="dataTableView">
                    <columns>
                        <TableColumn fx:id="studentNumColumn" prefWidth="100.0" text="学号" />
                        <TableColumn fx:id="studentNameColumn" prefWidth="80.0" text="学生姓名" />
                        <TableColumn fx:id="teacherNameColumn" prefWidth="120.0" text="审批教师" />
                        <TableColumn fx:id="leaveDateColumn" prefWidth="120.0" text="请假日期" />
                        <TableColumn fx:id="reasonColumn" prefWidth="200.0" text="请假原因" />
                        <TableColumn fx:id="stateNameColumn" prefWidth="80.0" text="状态" />
                        <TableColumn fx:id="teacherCommentColumn" prefWidth="120.0" text="教师意见" />
                        <TableColumn fx:id="adminCommentColumn" prefWidth="120.0" text="管理员意见" />
                    </columns>
                </TableView>
                <VBox alignment="TOP_CENTER" spacing="15.0">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <GridPane hgap="8.0" vgap="8.0">
                        <columnConstraints>
                            <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" maxWidth="90.0" minWidth="10.0" prefWidth="80.0" />
                            <ColumnConstraints hgrow="SOMETIMES" maxWidth="220.0" minWidth="10.0" prefWidth="180.0" />
                        </columnConstraints>
                        <rowConstraints>
                            <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="32.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
                            <RowConstraints minHeight="10.0" prefHeight="80.0" vgrow="SOMETIMES" />
                        </rowConstraints>
                        <children>
                            <Label text="学号：" GridPane.rowIndex="0" />
                            <TextField fx:id="studentNumField" GridPane.columnIndex="1" GridPane.rowIndex="0" styleClass="form-input" disable="true"/>
                            
                            <Label text="学生姓名：" GridPane.rowIndex="1" />
                            <TextField fx:id="studentNameField" GridPane.columnIndex="1" GridPane.rowIndex="1" styleClass="form-input" disable="true"/>
                            
                            <Label text="审批教师：" GridPane.rowIndex="2" />
                            <ComboBox fx:id="teacherComboBox" GridPane.columnIndex="1" GridPane.rowIndex="2" styleClass="combo-box-base" prefWidth="180.0"/>
                            
                            <Label text="请假日期：" GridPane.rowIndex="3" />
                            <TextField fx:id="leaveDateField" GridPane.columnIndex="1" GridPane.rowIndex="3" styleClass="form-input"/>
                            <Label fx:id="leaveDateErrorLabel" GridPane.columnIndex="1" GridPane.rowIndex="3" GridPane.valignment="BOTTOM" styleClass="error-label"/>
                            
                            <Label text="请假原因：" GridPane.rowIndex="4" />
                            <TextField fx:id="reasonField" GridPane.columnIndex="1" GridPane.rowIndex="4" styleClass="form-input" alignment="TOP_LEFT">
                                <padding>
                                    <Insets top="5.0" />
                                </padding>
                            </TextField>
                            <Label fx:id="reasonErrorLabel" GridPane.columnIndex="1" GridPane.rowIndex="4" GridPane.valignment="BOTTOM" styleClass="error-label"/>
                            
                            <Label text="教师意见：" GridPane.rowIndex="5" />
                            <TextField fx:id="teacherCommentField" GridPane.columnIndex="1" GridPane.rowIndex="5" styleClass="form-input" alignment="TOP_LEFT">
                                <padding>
                                    <Insets top="5.0" />
                                </padding>
                            </TextField>
                            <Label fx:id="teacherCommentErrorLabel" GridPane.columnIndex="1" GridPane.rowIndex="5" GridPane.valignment="BOTTOM" styleClass="error-label"/>
                        </children>
                    </GridPane>
                    
                    <FlowPane alignment="CENTER" columnHalignment="CENTER" prefHeight="40.0">
                        <Button fx:id="saveButton" onAction="#onSaveButtonClick" text="保存草稿" styleClass="button">
                            <FlowPane.margin>
                                <Insets right="8.0" top="5.0" />
                            </FlowPane.margin>
                        </Button>
                        <Button fx:id="submitButton" onAction="#onSubmitButtonClick" text="提交申请" styleClass="button">
                            <FlowPane.margin>
                                <Insets right="8.0" top="5.0" />
                            </FlowPane.margin>
                        </Button>
                    </FlowPane>
                    
                    <FlowPane alignment="CENTER" columnHalignment="CENTER" prefHeight="40.0">
                        <Button fx:id="passButton" onAction="#onPassButtonClick" text="批准" styleClass="button">
                            <FlowPane.margin>
                                <Insets right="8.0" top="5.0" />
                            </FlowPane.margin>
                        </Button>
                        <Button fx:id="notPassButton" onAction="#onNotPassButtonClick" text="拒绝" styleClass="button">
                            <FlowPane.margin>
                                <Insets right="8.0" top="5.0" />
                            </FlowPane.margin>
                        </Button>
                    </FlowPane>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>
